# Required: IP address of your Green Mountain Grill (or emulator)
GMG_GRILL_HOST=192.168.1.100

# Optional: External port for the web UI (default: 80)
# GMG_EXTERNAL_PORT=80

# Optional: Set to false to disable alert sounds in the browser (default: true)
# GMG_ALERTS_AUDIO_ENABLED=false

# Optional: Slack webhook URL for alerts
# GMG_ALERTS_SLACK_WEBHOOKURL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
